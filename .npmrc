# Prophecy's packages are private while the protocol completes verification.
# Set NPM_TOKEN to the Prophecy access key you were given, or re-scaffold with --access-key.
#
# Without a working key, npm answers 404 rather than 401 for these packages — it reads as
# "the package does not exist" and it means "you are not signed in".
@prophecy-dev:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
